---
import { SITE } from '../lib/data';
import { EXPERIENCE, TOOLS } from '../data/work';
import Icon from './Icon.astro';
---
<section class="section about" id="about" aria-labelledby="about-title">
  <div class="about__glow" aria-hidden="true"></div>
  <div class="container about__grid">
    <figure class="about__photo" data-reveal="clip">
      <picture>
        <source srcset="/images/me/portrait.webp" type="image/webp" />
        <img src="/images/me/portrait.jpg" alt="Portrait of Syeed Hossain Fahim" width="900" height="1100" decoding="async" />
      </picture>
      <figcaption class="about__badge"><span class="dot"></span> AI Visual Storyteller · Dhaka</figcaption>
    </figure>

    <div class="about__copy">
      <p class="eyebrow" data-reveal>About me</p>
      <h2 id="about-title" class="h-1" data-split>Designing at the edge of <span class="serif">art and strategy.</span></h2>
      <div class="about__text" data-scrub>
        <p>I’m Syeed Hossain Fahim, a designer and content developer from Dhaka. I create visuals and stories for Islamic and value-driven brands — e-commerce, social media and brand campaigns — using Photoshop, Illustrator, After Effects and AI tools.</p>
        <p>I work as a Content Developer at LustManager and founded Aiyaan, a home decor brand where I lead creative direction. Every day I test tools, prompts and repos, and share the free, genuinely useful ones here.</p>
      </div>
      <dl class="about__facts" data-stagger="120">
        <div data-reveal>
          <dt><span data-count="1000000" data-compact>1M</span></dt>
          <dd>monthly views on Pinterest across my work</dd>
        </div>
        <div data-reveal>
          <dt><span data-count="300000" data-compact data-suffix="+">300K+</span></dt>
          <dd>monthly Pinterest views for my “They Call Him” Islamic history series</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="container about__more">
    <ol class="xp" data-stagger="90">
      {EXPERIENCE.map((x) => (
        <li class="xp__item" data-reveal>
          <span class="xp__when">{x.when} {x.now && <span class="xp__now">Now</span>}</span>
          <h3 class="xp__role">{x.role}</h3>
          <p class="xp__org">{x.org}</p>
        </li>
      ))}
    </ol>
    <div class="tools" data-reveal>
      <p class="eyebrow">Tools & AI workflow</p>
      <ul>{TOOLS.map((t) => <li>{t}</li>)}</ul>
      <a class="btn btn-ghost" href="/work/#experience">Full experience & education <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .about { background: radial-gradient(60% 60% at 10% 20%, rgb(10 61 143 / 0.5), transparent 70%), var(--bg-deep); overflow: hidden; isolation: isolate; }
  .about__glow { position: absolute; inset: 0; z-index: -1; background: radial-gradient(30% 40% at 18% 30%, rgb(91 140 255 / 0.25), transparent 70%); }
  .about__grid { display: grid; gap: var(--s-7); align-items: center; }
  @media (min-width: 900px) { .about__grid { grid-template-columns: 5fr 7fr; gap: var(--s-8); } }
  .about__photo { position: relative; margin: 0; border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 4 / 5; max-width: 480px; background: var(--bg-blue); box-shadow: var(--shadow), 0 0 0 1px var(--border-strong), 0 0 90px -30px var(--glow); }
  .about__photo picture { position: absolute; inset: 0; }
  .about__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; }
  .about__badge {
    position: absolute; left: var(--s-4); bottom: var(--s-4); display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 999px;
    background: rgb(3 7 18 / 0.65); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); font-weight: 600; font-size: 0.85rem; border: 1px solid var(--border-strong);
  }
  .about__badge .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); }
  .about__text { margin-top: var(--s-5); display: grid; gap: var(--s-4); font-size: var(--step-1); line-height: 1.55; max-width: 36em; color: var(--text-soft); }
  .about__facts { margin-top: var(--s-6); display: grid; gap: var(--gutter); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .about__facts div { padding: var(--s-5); border-radius: var(--radius-l); background: var(--glass); border: 1px solid var(--border); }
  .about__facts dt { font-family: var(--font-sans); font-size: var(--step-4); font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .about__facts dd { margin-top: var(--s-2); color: var(--muted); max-width: 28ch; }

  .about__more { margin-top: var(--s-8); display: grid; gap: var(--s-6); }
  @media (min-width: 1000px) { .about__more { grid-template-columns: 2fr 1fr; align-items: start; } }
  .xp { list-style: none; padding: 0; display: grid; gap: var(--gutter); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .xp { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .xp__item { padding: var(--s-5); border-radius: var(--radius-l); border: 1px solid var(--border); background: rgb(255 255 255 / 0.02); }
  .xp__when { font-size: 0.8rem; color: var(--muted); display: flex; gap: 8px; align-items: center; }
  .xp__now { padding: 2px 8px; border-radius: 999px; background: rgb(74 222 128 / 0.12); color: var(--success); font-size: 0.7rem; font-weight: 600; }
  .xp__role { font-family: var(--font-display); font-size: var(--step-1); margin-top: var(--s-2); }
  .xp__org { color: var(--accent); font-size: 0.9rem; }
  .tools { padding: var(--s-5); border-radius: var(--radius-l); border: 1px solid var(--border); background: var(--glass); display: grid; gap: var(--s-4); justify-items: start; }
  .tools ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .tools li { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border-strong); font-size: 0.85rem; color: var(--text-soft); }
</style>
