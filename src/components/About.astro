---
import { SITE } from '../lib/data';
import Icon from './Icon.astro';
---
<section class="section theme-ocean grain about" id="about" aria-labelledby="about-title">
  <div class="about__glow" aria-hidden="true"></div>
  <div class="container about__grid">
    <figure class="about__photo">
      <img src="/images/me/portrait.jpg" alt="Portrait of Syeed Hossain Fahim" width="900" height="1100" loading="lazy" decoding="async" />
    </figure>
    <div class="about__copy">
      <p class="eyebrow">About me</p>
      <h2 id="about-title" class="h-1">Hi, I’m <span class="serif">Syeed Fahim.</span></h2>
      <div class="about__text">
        <p>I’m an AI visual storyteller from Dhaka, Bangladesh, making visuals for Islamic and value-driven brands. I’m also a content developer at LustManager.</p>
        <p>Every day I try out AI tools, prompts, workflows and open-source repos. The ones that are free and actually useful end up in an Instagram carousel — and every link lives here, so you never have to hunt for it.</p>
      </div>
      <dl class="about__facts">
        <div>
          <dt>1M</dt>
          <dd>monthly views on Pinterest across my work</dd>
        </div>
        <div>
          <dt>300K+</dt>
          <dd>monthly Pinterest views for my <span class="serif">“They Call Him”</span> Islamic history series</dd>
        </div>
      </dl>
      <div class="about__links">
        <a class="btn btn-primary" href={SITE.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> {SITE.instagramHandle}</a>
        <a class="btn btn-ghost" href={SITE.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about { overflow: hidden; isolation: isolate; }
  .about__glow { position: absolute; inset: 0; z-index: -1; background: radial-gradient(50% 60% at 15% 30%, rgb(81 134 179 / 0.55), transparent 70%); }
  .about__grid { display: grid; gap: var(--s-7); align-items: center; }
  @media (min-width: 900px) { .about__grid { grid-template-columns: 5fr 7fr; gap: var(--s-8); } }
  .about__photo { border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 9 / 11; background: var(--steel); max-width: 480px; box-shadow: 0 40px 80px -40px rgb(5 7 9 / 0.8); }
  .about__photo img { width: 100%; height: 100%; object-fit: cover; }
  .about__copy .h-1 .serif { color: var(--sand); }
  .about__text { margin-top: var(--s-5); display: grid; gap: var(--s-4); font-size: var(--step-1); line-height: 1.55; max-width: 34em; color: var(--muted); }
  .about__text p:first-child { color: var(--bone); }
  .about__facts { margin-top: var(--s-6); display: grid; gap: var(--gutter); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .about__facts div { border-top: 1px solid rgb(242 238 232 / 0.3); padding-top: var(--s-4); }
  .about__facts dt { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
  .about__facts dd { margin-top: var(--s-2); color: var(--muted); max-width: 26ch; }
  .about__links { margin-top: var(--s-6); display: flex; flex-wrap: wrap; gap: var(--s-3); }
</style>
