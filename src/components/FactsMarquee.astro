---
import { resources, posts } from '../lib/data';
// Real numbers only: counts are computed from the data files at build time.
const facts = [
  `${resources.length} free resource${resources.length === 1 ? '' : 's'}`,
  `${posts.length} post${posts.length === 1 ? '' : 's'} and counting`,
  '1M monthly views on Pinterest',
  'New every day',
  'Open for new projects',
];
const row = [...facts, ...facts];
---
<section class="facts" aria-label="At a glance">
  <ul class="sr-only">{facts.map((f) => <li>{f}</li>)}</ul>
  <div class="marquee" style="--dur:38s" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="marquee__track">
        {row.map((f) => (
          <span class="facts__item">{f}<span class="facts__sep">✦</span></span>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .facts { background: linear-gradient(90deg, var(--bg-blue), #1a4db8 50%, var(--bg-blue)); color: var(--text); padding-block: var(--s-4); border-block: 1px solid var(--border-strong); }
  .facts__item { display: inline-flex; align-items: center; gap: var(--s-5); padding-right: var(--s-5); white-space: nowrap; font-family: var(--font-sans); font-size: clamp(1.2rem, 1rem + 1.1vw, 1.9rem); font-weight: 700; letter-spacing: -0.02em; }
  .facts__item:nth-child(2n) { color: var(--text-soft); font-weight: 500; }
  .facts__sep { font-size: 0.6em; color: var(--accent-soft); }
</style>
