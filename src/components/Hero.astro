---
import { posts, thumb, formatDate } from '../lib/data';
import Icon from './Icon.astro';

// Fill the ring with slides from the latest posts (newest first), 8–12 cards.
type Card = { src: string; href: string; alt: string };
let cards: Card[] = [];
for (const p of posts) {
  p.slides.forEach((s, i) =>
    cards.push({ src: thumb(s), href: `/p/${p.slug}/`, alt: `${p.title} — slide ${i + 1} (${formatDate(p.date)})` }),
  );
  if (cards.length >= 12) break;
}
cards = cards.slice(0, 12);
while (cards.length > 0 && cards.length < 8) cards = cards.concat(cards).slice(0, 8);
const latest = posts[0];
---
<section class="hero theme-dark grain" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true" data-parallax="0.25"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__hi hero__in" style="--d:0">
        <img src="/images/me/avatar.webp" alt="" width="40" height="40" />
        <span>Curated by <strong>Syeed Fahim</strong> · new every day</span>
      </p>
      <h1 id="hero-title" class="h-display hero__title">
        <span class="line"><span class="hero__in" style="--d:1">Free resources</span></span>
        <span class="line"><span class="hero__in" style="--d:2">for designers,</span></span>
        <span class="line"><span class="hero__in serif" style="--d:3">every single day.</span></span>
      </h1>
      <p class="lede hero__in hero__lede" style="--d:4">
        AI tools, prompts, GitHub repos, fonts, textures and Figma plugins — hand-picked, free, and linked straight to the official source.
      </p>
      <div class="hero__ctas hero__in" style="--d:5">
        <a class="btn btn-primary" href="#resources" data-magnetic>Browse resources <Icon name="arrow-right" /></a>
        {latest && <a class="btn btn-ghost" href={`/p/${latest.slug}/`} data-magnetic>Today’s drop</a>}
      </div>
    </div>

    <figure class="hero__me hero__pop" aria-hidden="true" data-parallax="-0.12">
      <picture>
        <source srcset="/images/me/hero.webp" type="image/webp" />
        <img src="/images/me/hero.jpg" alt="" width="720" height="900" fetchpriority="high" />
      </picture>
      <figcaption class="hero__tag hero__tag--a"><span class="dot"></span> Posting daily on Instagram</figcaption>
      <figcaption class="hero__tag hero__tag--b"><span class="serif">1M</span> monthly Pinterest views</figcaption>
    </figure>
  </div>

  {cards.length > 0 && (
    <div class="spin" data-spin>
      <div
        class="spin__stage"
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label="Latest post covers. Drag, or use the left and right arrow keys to spin. Press Enter to open the post at the front."
        data-stage
      >
        <div class="spin__ring" data-ring style={`--n:${cards.length}`}>
          {cards.map((c, i) => (
            <a class="spin__card" href={c.href} tabindex="-1" style={`--i:${i}`} draggable="false" data-card>
              <img src={c.src} alt={c.alt} width="480" height="600" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
            </a>
          ))}
        </div>
      </div>
      <p class="spin__hint" aria-hidden="true"><span class="spin__dot"></span> Drag to spin</p>
    </div>
  )}
</section>

<style>
  .hero { padding-top: calc(68px + clamp(2rem, 1rem + 4vw, 5rem)); padding-bottom: var(--s-7); overflow: hidden; position: relative; isolation: isolate; }
  .hero__glow {
    position: absolute; inset: -10% 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(55% 45% at 78% 8%, rgb(81 134 179 / 0.5), transparent 70%),
      radial-gradient(45% 40% at 6% 70%, rgb(24 74 106 / 0.95), transparent 70%),
      radial-gradient(70% 40% at 50% 105%, rgb(81 134 179 / 0.35), transparent 70%);
  }
  .hero__grid { display: grid; gap: var(--s-7); align-items: center; }
  @media (min-width: 1100px) { .hero__grid { grid-template-columns: minmax(0, 1fr) minmax(300px, 400px); gap: var(--s-8); } }

  .hero__hi {
    display: inline-flex; align-items: center; gap: var(--s-3); padding: 4px 16px 4px 4px; border-radius: 999px;
    background: rgb(242 238 232 / 0.08); border: 1px solid var(--line-dark); font-size: 0.875rem; color: var(--on-dark-muted);
  }
  .hero__hi img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
  .hero__hi strong { color: var(--bone); font-weight: 600; }
  .hero__title { margin-top: var(--s-5); max-width: 12ch; }
  .hero__title .line { display: block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .hero__title .line > span { display: inline-block; }
  .hero__title .serif { color: var(--sand); font-size: 1.04em; letter-spacing: -0.02em; }
  .hero__lede { margin-top: var(--s-5); }
  .hero__ctas { margin-top: var(--s-5); display: flex; flex-wrap: wrap; gap: var(--s-3); }

  /* Portrait card */
  .hero__me { position: relative; display: none; margin: 0; }
  @media (min-width: 1100px) { .hero__me { display: block; } }
  .hero__me picture { display: block; border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 4 / 5; transform: rotate(2.5deg); box-shadow: 0 50px 90px -40px rgb(5 7 9 / 0.9), 0 0 0 1px rgb(242 238 232 / 0.1); }
  .hero__me img { width: 100%; height: 100%; object-fit: cover; }
  .hero__tag {
    position: absolute; display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px;
    font-size: 0.875rem; font-weight: 600; white-space: nowrap; box-shadow: 0 20px 40px -20px rgb(5 7 9 / 0.8);
    animation: bob 5s ease-in-out infinite;
  }
  .hero__tag--a { left: -48px; top: 14%; background: var(--bone); color: var(--ink); }
  .hero__tag--b { right: -28px; bottom: 12%; background: var(--sand); color: var(--ink); animation-delay: -2.5s; }
  .hero__tag--b .serif { font-size: 1.25rem; }
  .hero__tag .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--steel); box-shadow: 0 0 0 4px rgb(81 134 179 / 0.25); }
  @keyframes bob { 50% { transform: translateY(-10px); } }

  /* Orchestrated entrance — waits for the preloader (html.is-ready) */
  .hero__in { animation: rise 1s var(--ease-out) both paused; animation-delay: calc(var(--d) * 90ms + 60ms); }
  .hero__title .hero__in { animation-name: rise-line; animation-duration: 1.2s; }
  :global(html.is-ready) .hero__in, :global(html.is-ready) .hero__pop, :global(html.is-ready) .spin__stage { animation-play-state: running; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); filter: blur(6px); } }
  @keyframes rise-line { from { transform: translateY(110%) rotate(2deg); } }
  .hero__pop { animation: pop 1.4s var(--ease-out) 0.35s both paused; }
  @keyframes pop { from { opacity: 0; transform: translateY(70px) scale(0.88) rotate(6deg); } }
  .hero__me .hero__tag { opacity: 0; }
  :global(html.is-ready) .hero__me .hero__tag { opacity: 1; transition: opacity 0.8s 1.3s; }

  .spin { margin-top: clamp(1rem, 0rem + 3vw, 3rem); position: relative; }
  .spin__stage {
    --w: 150px;
    height: calc(var(--w) * 1.25 + 120px);
    perspective: 1600px; perspective-origin: 50% 30%;
    display: grid; place-items: center; cursor: grab; touch-action: pan-y; outline-offset: -4px;
    animation: ring-in 1.8s var(--ease-out) 0.5s both paused;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .spin__stage:active { cursor: grabbing; }
  @keyframes ring-in { from { opacity: 0; transform: translateY(90px) scale(0.45); } }
  .spin__ring {
    position: relative; width: var(--w); aspect-ratio: 4 / 5; transform-style: preserve-3d;
    transform: rotateX(-6deg) rotateY(var(--a, 0deg));
  }
  .spin__card {
    position: absolute; inset: 0; border-radius: var(--radius-m); overflow: hidden;
    transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(var(--r, 300px));
    box-shadow: 0 30px 60px -20px rgb(5 7 9 / 0.8), 0 0 0 1px rgb(242 238 232 / 0.08);
    background: var(--midnight); -webkit-user-drag: none; user-select: none;
    backface-visibility: hidden;
  }
  .spin__card img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .spin__hint {
    display: flex; align-items: center; justify-content: center; gap: var(--s-2);
    font-size: var(--step--1); letter-spacing: 0.12em; text-transform: uppercase; color: var(--on-dark-muted); font-weight: 600;
  }
  .spin__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--sand); box-shadow: 0 0 0 4px rgb(221 173 159 / 0.2); animation: pulse 1.8s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 9px rgb(221 173 159 / 0); } }
  @media (min-width: 600px) { .spin__stage { --w: 190px; } }
  @media (min-width: 1100px) { .spin__stage { --w: 220px; perspective: 2200px; } }
</style>

<script>
  import { motionOn, onReady } from '../scripts/motion-state';

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const ring = document.querySelector<HTMLElement>('[data-ring]');
  if (stage && ring) {
    const cards = Array.from(ring.querySelectorAll<HTMLAnchorElement>('[data-card]'));
    const n = cards.length;
    const step = 360 / n;
    const idle = () => (!motionOn() || document.activeElement === stage ? 0 : -0.012); // deg/ms drift; pauses while focused
    let angle = motionOn() ? 200 : 0; // entrance: swings in from the side
    let vel = 0;
    let dragging = false, moved = 0, lastX = 0, lastT = 0, raf = 0, prev = performance.now();
    let visible = true;

    const radius = () => {
      const w = ring.offsetWidth || 200; // layout width, unaffected by the entrance scale
      return Math.round((w * 0.6) / Math.tan(Math.PI / n));
    };
    const layout = () => ring.style.setProperty('--r', radius() + 'px');
    layout();
    window.addEventListener('resize', layout);

    const paint = () => {
      ring.style.setProperty('--a', angle + 'deg');
      for (let i = 0; i < n; i++) {
        const rel = ((i * step + angle) % 360 + 540) % 360 - 180; // −180..180, 0 = front
        const f = Math.cos((rel * Math.PI) / 180);
        cards[i].style.filter = `brightness(${(0.45 + 0.55 * Math.max(f, 0)).toFixed(3)})`;
      }
    };
    const frontIndex = () => {
      let best = 0, bestD = 999;
      for (let i = 0; i < n; i++) {
        const d = Math.abs(((i * step + angle) % 360 + 540) % 360 - 180);
        if (d < bestD) { bestD = d; best = i; }
      }
      return best;
    };

    const tick = (t: number) => {
      const dt = Math.min(48, t - prev); prev = t;
      if (!dragging) {
        vel += (idle() - vel) * Math.min(1, dt * 0.0016); // ease toward idle drift
        angle += vel * dt;
      }
      paint();
      raf = visible ? requestAnimationFrame(tick) : 0;
    };
    const start = () => { if (!raf) { prev = performance.now(); raf = requestAnimationFrame(tick); } };
    paint();
    // Spin-in starts with the hero entrance, after the preloader.
    onReady(() => { if (motionOn()) vel = -0.6; start(); });

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible && document.documentElement.classList.contains('is-ready')) start(); }).observe(stage);

    stage.addEventListener('pointerdown', (e) => {
      dragging = true; moved = 0; lastX = e.clientX; lastT = performance.now(); vel = 0;
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const now = performance.now();
      const dx = e.clientX - lastX;
      moved += Math.abs(dx);
      angle += dx * 0.32;
      vel = (dx * 0.32) / Math.max(8, now - lastT);
      lastX = e.clientX; lastT = now;
      if (!raf) paint();
    });
    const end = () => { dragging = false; if (!motionOn()) vel = 0; };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
    ring.addEventListener('click', (e) => { if (moved > 6) { e.preventDefault(); moved = 0; } }, true);

    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        angle = Math.round(angle / step) * step + (e.key === 'ArrowLeft' ? step : -step);
        vel = 0; paint();
      } else if (e.key === 'Enter') {
        cards[frontIndex()].click();
      }
    });
  }
</script>
