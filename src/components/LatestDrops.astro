---
import { posts, thumb, formatDate } from '../lib/data';
import Icon from './Icon.astro';
interface Props { exclude?: string; title?: string; limit?: number }
const { exclude, title = 'Latest drops', limit = 9 } = Astro.props;
const list = posts.filter((p) => p.slug !== exclude).slice(0, limit);
---
{list.length > 0 && (
  <section class="section theme-ink drops" id="drops" aria-labelledby="drops-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">One post a day</p>
          <h2 id="drops-title" class="h-1" data-split>{title}</h2>
        </div>
        <p class="muted measure" data-reveal>Each Instagram carousel gets its own page with every official link — the same page you get in your DM.</p>
      </div>
      <ul class:list={["drops__grid", { "drops__grid--single": list.length === 1 }]} data-stagger="120">
        {list.map((p, i) => (
          <li data-reveal>
            <a class="drop" href={`/p/${p.slug}/`} data-tilt>
              <div class="drop__img" data-reveal="clip">
                <img src={thumb(p.cover)} alt="" width="480" height="600" loading="lazy" decoding="async" />
                {i === 0 && !exclude && <span class="badge badge-new drop__badge">Latest</span>}
              </div>
              <div class="drop__body">
                <p class="drop__meta"><time datetime={p.date}>{formatDate(p.date)}</time> · {p.resources.length} resources</p>
                <h3 class="h-3">{p.title}</h3>
                <p class="drop__hook">{p.hook}</p>
                <span class="drop__more">Open the links <Icon name="arrow-right" /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .drops__grid { list-style: none; padding: 0; display: grid; gap: var(--gutter); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .drops__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .drops__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .drops__grid--single { grid-template-columns: 1fr !important; }
  @media (min-width: 640px) {
    .drops__grid--single .drop { grid-template-columns: minmax(200px, 320px) 1fr; padding: var(--s-3); gap: var(--s-6); }
    .drops__grid--single .drop__body { gap: var(--s-3); }
    .drops__grid--single .h-3 { font-size: var(--step-3); letter-spacing: -0.02em; }
    .drops__grid--single .drop__hook { font-size: var(--step-1); -webkit-line-clamp: 4; max-width: 40ch; }
  }
  .drop {
    display: grid; grid-template-columns: 112px 1fr; gap: var(--s-4); text-decoration: none; height: 100%;
    padding: var(--s-3); border-radius: var(--radius-l); border: 1px solid var(--border); background: var(--glass);
    transition: border-color 0.2s, background-color 0.2s;
  }
  .drop:hover { border-color: rgb(122 162 255 / 0.4); background: rgb(10 61 143 / 0.3); }
  @media (min-width: 640px) { .drop { grid-template-columns: 1fr; padding: var(--s-3) var(--s-3) var(--s-5); } }
  .drop__img { position: relative; border-radius: var(--radius-m); overflow: hidden; aspect-ratio: 4 / 5; background: var(--midnight); }
  .drop__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out); }
  .drop:hover .drop__img img { transform: scale(1.03); }
  .drop__badge { position: absolute; top: var(--s-3); left: var(--s-3); }
  .drop__body { display: flex; flex-direction: column; gap: var(--s-2); padding-inline: var(--s-2); align-self: center; }
  .drop__meta { font-size: var(--step--1); color: var(--on-dark-muted); font-variant-numeric: tabular-nums; }
  .drop__hook { color: var(--on-dark-muted); font-size: 0.9375rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .drop__more { display: inline-flex; gap: var(--s-2); align-items: center; font-weight: 600; color: var(--sand); margin-top: var(--s-2); }
  .drop__more :global(svg) { width: 1em; height: 1em; }
</style>
