---
import { SITE } from '../lib/data';
import Icon from './Icon.astro';
const steps = [
  { icon: 'message', title: 'Comment “LINK”', body: 'On any of my daily Instagram carousels. One word is all it takes.' },
  { icon: 'send', title: 'Get the DM', body: 'I send you the page for that post, with every official link in one place.' },
  { icon: 'bookmark', title: 'Save the post', body: 'So the list is always there when you need it, and you never lose a link again.' },
] as const;
---
<section class="section theme-light dm" id="dm" aria-labelledby="dm-title">
  <div class="container dm__grid">
    <div class="dm__side">
      <p class="eyebrow" data-reveal>How it works</p>
      <h2 id="dm-title" class="h-1" data-split>Get every link <span class="serif">in your DM.</span></h2>
      <figure class="dm__photo" data-reveal="clip">
        <picture>
          <source srcset="/images/me/dm.webp" type="image/webp" />
          <img src="/images/me/dm.jpg" alt="Syeed Fahim" width="720" height="900" decoding="async" data-parallax="0.06" />
        </picture>
      </figure>
      <div class="dm__cta" data-reveal>
        <a class="btn btn-primary" href={SITE.instagram} target="_blank" rel="noopener" data-magnetic><Icon name="instagram" /> Follow {SITE.instagramHandle}</a>
        <p class="muted">A new carousel drops every day.</p>
      </div>
    </div>

    <ol class="dm__steps" data-stack>
      {steps.map((s, i) => (
        <li class="dm__step" style={`--k:${i}`}>
          <span class="dm__n serif" aria-hidden="true">0{i + 1}</span>
          <span class="dm__icon"><Icon name={s.icon} /></span>
          <h3 class="dm__title">{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .dm__grid { display: grid; gap: var(--s-7); }
  @media (min-width: 960px) { .dm__grid { grid-template-columns: 5fr 6fr; gap: var(--s-8); align-items: start; } .dm__side { position: sticky; top: 110px; } }
  .dm__side { display: grid; gap: var(--s-4); align-content: start; }
  .dm__side .serif { color: var(--ocean); }
  .dm__photo { margin: var(--s-3) 0 0; border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 5 / 4; background: var(--midnight); max-width: 520px; }
  .dm__photo picture { height: 100%; }
  .dm__photo img { width: 100%; height: 115%; object-fit: cover; object-position: 50% 20%; margin-top: -7%; }
  .dm__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-4); }

  .dm__steps { list-style: none; padding: 0; display: grid; gap: var(--s-5); padding-bottom: var(--s-6); }
  .dm__step {
    position: sticky; top: calc(100px + var(--k) * 28px);
    min-height: clamp(260px, 32vw, 340px); padding: var(--s-6); border-radius: var(--radius-l);
    display: flex; flex-direction: column; gap: var(--s-3); overflow: hidden; transform-origin: 50% 0;
    background: var(--midnight); color: var(--bone); box-shadow: 0 -20px 50px -30px rgb(5 7 9 / 0.6);
    isolation: isolate;
  }
  .dm__step::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(70% 70% at 100% 0%, rgb(81 134 179 / 0.45), transparent 70%); }
  .dm__step:nth-child(2) { background: var(--ocean); }
  .dm__step:nth-child(3) { background: var(--ink); }
  .dm__step p { color: var(--on-dark-muted); font-size: var(--step-1); max-width: 30ch; }
  .dm__title { font-size: var(--step-3); letter-spacing: -0.035em; font-weight: 800; margin-top: auto; line-height: 1.05; }
  .dm__n { position: absolute; right: var(--s-5); top: var(--s-3); font-size: clamp(4rem, 3rem + 4vw, 7rem); line-height: 1; color: var(--sand); opacity: 0.9; }
  .dm__icon { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; background: var(--sand); color: var(--ink); }
  .dm__icon :global(svg) { width: 24px; height: 24px; }
</style>
