---
import { posts, thumb } from '../lib/data';
import { PROFILE } from '../data/work';
import Icon from './Icon.astro';
// Mosaic of post slides; repeat to fill a long strip.
let tiles = posts.flatMap((p) => p.slides.slice(0, 4).map((s) => ({ src: thumb(s), href: `/p/${p.slug}/` }))).slice(0, 16);
while (tiles.length > 0 && tiles.length < 10) tiles = tiles.concat(tiles);
const year = new Date().getFullYear();
const cols = [
  { title: 'Explore', links: [['Work', '/work/'], ['Services', '/#services'], ['Free resources', '/resources/'], ['Daily drops', '/#drops'], ['About', '/#about']] },
  { title: 'Resources', links: [['AI tools', '/resources/#cat-ai-tools'], ['Prompts', '/resources/#cat-prompts'], ['GitHub repos', '/resources/#cat-github'], ['Fonts', '/resources/#cat-fonts'], ['Figma plugins', '/resources/#cat-figma-plugins']] },
  { title: 'Connect', links: [['Instagram', PROFILE.instagram], ['LinkedIn', PROFILE.linkedin], ['WhatsApp', PROFILE.whatsapp], ['Email', `mailto:${PROFILE.email}`]] },
];
---
<footer class="footer">
  {tiles.length > 0 && (
    <div class="marquee footer__mosaic" style="--dur:60s" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="marquee__track">
          {tiles.map((t, i) => (
            <a href={t.href} tabindex="-1" class:list={['tile', { 'tile--up': i % 2 === 1 }]}>
              <img src={t.src} alt="" width="480" height="600" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      ))}
    </div>
  )}
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__name">Syeed Hossain Fahim</a>
      <p class="muted">AI visual storyteller & content developer. Free design resources, every single day.</p>
      <span class="pill-live">Available for work</span>
    </div>
    {cols.map((c) => (
      <nav class="footer__col" aria-label={c.title}>
        <p class="footer__h">{c.title}</p>
        <ul>
          {c.links.map(([label, href]) => (
            <li><a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="container footer__legal">
    <p>© {year} Syeed Hossain Fahim · Designed & built in Dhaka. Resources belong to their creators; links go to the official sources.</p>
    <p class="footer__right">
      <button class="footer__motion" type="button" data-motion-toggle aria-pressed="false">Motion: <span data-motion-label>On</span></button>
      <a href="/sitemap.xml">Sitemap</a>
      <a href="#main" class="footer__top">Back to top <Icon name="arrow-up-right" /></a>
    </p>
  </div>
</footer>

<style>
  .footer { background: var(--bg); border-top: 1px solid var(--border); padding-bottom: var(--s-6); }
  .footer__mosaic { padding-block: var(--s-7) var(--s-6); }
  .footer__mosaic .marquee__track { gap: var(--s-3); padding-right: var(--s-3); align-items: center; }
  :global(html.motion-off) .footer__mosaic .marquee__track { flex-wrap: nowrap; justify-content: flex-start; overflow: hidden; }
  .tile { flex: none; width: 120px; aspect-ratio: 4 / 5; border-radius: var(--radius-m); overflow: hidden; background: var(--bg-deep); opacity: 0.85; border: 1px solid var(--border); }
  .tile--up { transform: translateY(-14px); }
  .tile img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 900px) { .tile { width: 156px; } }
  .footer__grid { display: grid; gap: var(--s-6); padding-block: var(--s-7); border-top: 1px solid var(--border); grid-template-columns: 1fr 1fr; }
  .footer__brand { grid-column: 1 / -1; display: grid; gap: var(--s-3); justify-items: start; max-width: 34ch; }
  @media (min-width: 900px) { .footer__grid { grid-template-columns: 2fr 1fr 1fr 1fr; } .footer__brand { grid-column: auto; } }
  .footer__name { font-family: var(--font-display); font-size: var(--step-2); font-weight: 800; letter-spacing: -0.02em; text-decoration: none; }
  .footer__h { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: var(--s-3); }
  .footer__col ul { list-style: none; padding: 0; display: grid; gap: 2px; }
  .footer__col a { display: inline-flex; min-height: 36px; align-items: center; text-decoration: none; color: var(--text-soft); }
  .footer__col a:hover { color: var(--text); }
  .footer__legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-3); padding-top: var(--s-5); border-top: 1px solid var(--border); font-size: var(--step--1); color: var(--muted); }
  .footer__right { display: flex; flex-wrap: wrap; gap: var(--s-4); align-items: center; }
  .footer__right a { text-underline-offset: 3px; }
  .footer__top { display: inline-flex; gap: 6px; align-items: center; }
  .footer__top :global(svg) { width: 14px; height: 14px; transform: rotate(-45deg); }
  .footer__motion { background: none; border: 1px solid var(--border-strong); border-radius: 999px; padding: 6px 14px; min-height: 36px; cursor: pointer; color: var(--text-soft); font-size: var(--step--1); }
  .footer__motion:hover { color: var(--text); border-color: var(--text); }
</style>
