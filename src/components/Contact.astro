---
import { PROFILE } from '../data/work';
import Icon from './Icon.astro';
const ways = [
  { label: 'Instagram DM', sub: '@syeed_fahim', href: PROFILE.instagram, icon: 'instagram' },
  { label: 'WhatsApp', sub: PROFILE.phone, href: PROFILE.whatsapp, icon: 'message' },
  { label: 'Email', sub: PROFILE.email, href: `mailto:${PROFILE.email}`, icon: 'send' },
  { label: 'LinkedIn', sub: 'in/syeedfahim', href: PROFILE.linkedin, icon: 'linkedin' },
] as const;
---
<section class="section contact grain" id="contact" aria-labelledby="contact-title">
  <div class="contact__glow" aria-hidden="true" data-parallax="0.15"></div>
  <div class="container">
    <p class="eyebrow" data-reveal>Let’s talk</p>
    <h2 id="contact-title" class="contact__title" data-split>Have an idea? <span class="serif">Let’s make it worth the scroll.</span></h2>
    <ul class="contact__ways" data-stagger="80">
      {ways.map((w) => (
        <li data-reveal>
          <a href={w.href} target={w.href.startsWith('http') ? '_blank' : undefined} rel={w.href.startsWith('http') ? 'noopener' : undefined} class="way" data-tilt>
            <span class="way__icon"><Icon name={w.icon} /></span>
            <span class="way__label">{w.label}</span>
            <span class="way__sub">{w.sub}</span>
            <span class="way__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="contact__note" data-reveal>Usually replies within a day · Based in Dhaka, working worldwide</p>
  </div>
</section>

<style>
  .contact { background: var(--bg); overflow: hidden; isolation: isolate; text-align: center; }
  .contact__glow { position: absolute; inset: 10% 0 -20%; z-index: -1; background: radial-gradient(45% 55% at 50% 60%, rgb(10 61 143 / 0.85), transparent 70%), radial-gradient(25% 30% at 50% 65%, rgb(91 140 255 / 0.35), transparent 70%); }
  .contact .eyebrow { justify-content: center; }
  .contact__title { font-family: var(--font-display); font-size: clamp(2.4rem, 1rem + 6vw, 6rem); line-height: 1; letter-spacing: -0.035em; font-weight: 800; margin: var(--s-5) auto 0; max-width: 16ch; }
  .contact__ways { list-style: none; padding: 0; margin-top: var(--s-8); display: grid; gap: var(--gutter); grid-template-columns: 1fr; text-align: left; }
  @media (min-width: 640px) { .contact__ways { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .contact__ways { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .way { position: relative; display: grid; gap: 4px; padding: var(--s-5); border-radius: var(--radius-l); background: var(--glass); border: 1px solid var(--border); text-decoration: none; backdrop-filter: blur(14px); transition: border-color 0.3s, background-color 0.3s; }
  .way:hover { border-color: rgb(122 162 255 / 0.45); background: rgb(10 61 143 / 0.35); }
  .way__icon { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; background: var(--text); color: var(--bg); margin-bottom: var(--s-4); }
  .way__icon :global(svg) { width: 20px; height: 20px; }
  .way__label { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); }
  .way__sub { color: var(--muted); font-size: 0.9rem; overflow-wrap: anywhere; }
  .way__arrow { position: absolute; top: var(--s-5); right: var(--s-5); color: var(--muted); transition: transform 0.3s var(--ease-out), color 0.3s; }
  .way:hover .way__arrow { color: var(--text); transform: translate(3px, -3px); }
  .way__arrow :global(svg) { width: 20px; height: 20px; }
  .contact__note { margin-top: var(--s-6); color: var(--muted); font-size: 0.9rem; }
</style>
