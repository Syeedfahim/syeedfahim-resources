---
import { GALLERY } from '../data/work';
import Icon from './Icon.astro';
interface Props { all?: boolean }
const { all = false } = Astro.props;
const items = all ? GALLERY : GALLERY.slice(0, 6);
---
<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow" data-reveal>Selected work</p>
        <h2 id="work-title" class="h-1" data-split>Visuals that sell <span class="serif">and tell a story.</span></h2>
      </div>
      {!all && <a class="btn btn-ghost" href="/work/" data-reveal data-magnetic>See all work <Icon name="arrow-right" /></a>}
    </div>
    <ul class="work__grid" data-stagger="90">
      {items.map((w, i) => (
        <li class:list={['work__item', `work__item--${i}`]} data-reveal>
          <a href={w.href} target="_blank" rel="noopener" class="work__link" data-tilt>
            <div class="work__img"><img src={w.img} alt={`${w.title} — ${w.tag}`} width={w.w} height={w.h} loading="lazy" decoding="async" /></div>
            <div class="work__cap">
              <span class="work__tag">{w.tag}</span>
              <span class="work__title">{w.title}</span>
            </div>
            <span class="work__go" aria-hidden="true"><Icon name="arrow-up-right" /></span>
            <span class="sr-only">(opens on Behance in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work { background: var(--bg-deep); }
  .work__grid { list-style: none; padding: 0; display: grid; gap: var(--gutter); grid-template-columns: 1fr; }
  @media (min-width: 700px) { .work__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) {
    .work__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: 260px; }
    .work__item--0 { grid-column: span 7; grid-row: span 2; }
    .work__item--1 { grid-column: span 5; grid-row: span 2; }
    .work__item--2 { grid-column: span 5; grid-row: span 1; }
    .work__item--3 { grid-column: span 3; grid-row: span 2; }
    .work__item--4 { grid-column: span 4; grid-row: span 2; }
    .work__item--5 { grid-column: span 5; grid-row: span 1; }
  }
  .work__link { position: relative; display: block; height: 100%; min-height: 280px; border-radius: var(--radius-l); overflow: hidden; border: 1px solid var(--border); text-decoration: none; isolation: isolate; background: var(--glass); }
  .work__img { position: absolute; inset: 0; z-index: -1; }
  .work__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease-out); }
  .work__link:hover .work__img img { transform: scale(1.05); }
  .work__link::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 45%, rgb(3 7 18 / 0.9)); }
  .work__cap { position: absolute; left: var(--s-5); right: var(--s-8); bottom: var(--s-5); display: grid; gap: 4px; }
  .work__tag { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-soft); }
  .work__title { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); line-height: 1.15; }
  .work__go { position: absolute; right: var(--s-4); bottom: var(--s-4); width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--text); color: var(--bg); transform: scale(0.8); opacity: 0; transition: transform 0.4s var(--ease-out), opacity 0.3s; }
  .work__go :global(svg) { width: 18px; height: 18px; }
  .work__link:hover .work__go, .work__link:focus-visible .work__go { transform: none; opacity: 1; }
</style>
