---
import { SERVICES, VALUES } from '../data/work';
import Icon from './Icon.astro';
---
<section class="section services theme-ocean" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow" data-reveal>What I can do for you</p>
        <h2 id="services-title" class="h-1" data-split>Hire me for <span class="serif">visuals with values.</span></h2>
      </div>
      <p class="muted" data-reveal>For brands that want premium, halal-friendly visuals. Send a DM on Instagram or WhatsApp with your idea — I’ll reply with a plan.</p>
    </div>

    <ul class="svc" data-stagger="80">
      {SERVICES.map((s, i) => (
        <li class="svc__item" data-reveal tabindex="0">
          <img class="svc__img" src={s.img} alt="" width="900" height="900" loading="lazy" decoding="async" />
          <div class="svc__body">
            <span class="svc__n">0{i + 1}</span>
            <h3 class="svc__title">{s.title}</h3>
            <p class="svc__text">{s.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="svc__foot" data-reveal>
      <ul class="svc__values" aria-label="My values">
        {VALUES.map((v) => <li>{v}</li>)}
      </ul>
      <a class="btn btn-primary" href="#contact" data-magnetic>Start a project <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  /* Hover-expanding strips on desktop, stacked cards on mobile */
  .svc { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .svc__item {
    position: relative; overflow: hidden; border-radius: var(--radius-l); border: 1px solid var(--border); min-height: 300px;
    background: var(--bg-deep); isolation: isolate; outline-offset: 4px;
  }
  .svc__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; opacity: 0.55; transform: scale(1.06); transition: transform 1s var(--ease-out), opacity 0.6s; }
  .svc__item::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(3 7 18 / 0.15), rgb(3 7 18 / 0.92) 75%); }
  .svc__body { position: absolute; inset: auto 0 0 0; padding: var(--s-5); display: grid; gap: var(--s-2); }
  .svc__n { font-family: var(--font-display); color: var(--accent); font-size: 0.9rem; }
  .svc__title { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.1; letter-spacing: -0.02em; }
  .svc__text { color: var(--text-soft); max-width: 34ch; }
  .svc__item:hover .svc__img, .svc__item:focus-within .svc__img, .svc__item:focus .svc__img { opacity: 0.85; transform: none; }

  @media (min-width: 1000px) {
    .svc { display: flex; height: 480px; gap: var(--s-3); }
    .svc__item { flex: 1; min-height: 0; transition: flex 0.7s var(--ease-out); cursor: default; }
    .svc__item:hover, .svc__item:focus { flex: 3.2; }
    .svc:not(:hover) .svc__item:first-child { flex: 3.2; }
    .svc__text { opacity: 0; transform: translateY(10px); transition: opacity 0.4s, transform 0.5s var(--ease-out); }
    .svc__item:hover .svc__text, .svc__item:focus .svc__text, .svc:not(:hover) .svc__item:first-child .svc__text { opacity: 1; transform: none; transition-delay: 0.2s; }
    .svc__title { white-space: nowrap; }
  }

  .svc__foot { margin-top: var(--s-6); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-4); }
  .svc__values { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .svc__values li { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--border-strong); font-size: 0.85rem; color: var(--text-soft); background: rgb(3 7 18 / 0.35); }
</style>
