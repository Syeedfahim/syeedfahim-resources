---
import { CATEGORIES, resources } from '../lib/data';
import ResourceCard from './ResourceCard.astro';

const tabs = [
  { key: 'all', label: 'All', items: resources },
  ...CATEGORIES.map((c) => ({ key: c.key, label: c.label, items: resources.filter((r) => r.category === c.key) })),
];
---
<section class="section res grain" id="resources" aria-labelledby="res-title">
  <!-- Hash targets for the nav (#prompts, #github, #fonts …) -->
  {CATEGORIES.map((c) => <span id={c.key === 'github' ? 'github' : c.key === 'prompts' ? 'prompts' : c.key === 'fonts' ? 'fonts' : `cat-${c.key}`} class="res__anchor" aria-hidden="true"></span>)}
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">The library</p>
        <h2 id="res-title" class="h-1" data-split>Every resource, <span class="serif">one tap away.</span></h2>
      </div>
      <p class="muted measure" data-reveal>Each card says why it’s useful, shows its licence, and links to the official source — never a re-upload.</p>
    </div>

    <div class="tabs" data-reveal role="tablist" aria-label="Resource categories" data-tablist>
      {tabs.map((t, i) => (
        <button
          role="tab"
          class="tab"
          id={`tab-${t.key}`}
          aria-controls={`panel-${t.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={t.key}
        >
          {t.label} <span class="tab__count">{t.items.length}</span>
        </button>
      ))}
    </div>

    {tabs.map((t, i) => (
      <div role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} tabindex="0" class="panel" hidden={i !== 0}>
        {t.items.length > 0 ? (
          <div class="bento" data-stagger="90">
            {t.items.map((r, j) => <ResourceCard r={r} featured={j === 0} index={j} />)}
          </div>
        ) : (
          <p class="empty">Nothing here yet — the first {t.label.toLowerCase()} drop is coming soon. <a href="#dm">Get it in your DM</a>.</p>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .res { background: color-mix(in srgb, var(--bone) 84%, var(--sand)); color: var(--ink); --muted: var(--slate); --line: var(--line-light); }
  .res .eyebrow { --accent: var(--ocean); }
  .res .h-1 .serif { color: var(--ocean); }
  .res__anchor { position: absolute; top: 0; }

  .tabs {
    display: flex; gap: var(--s-2); overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--margin) * -1);
    padding: 2px var(--margin) var(--s-5); scroll-snap-type: x proximity;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab {
    flex: none; scroll-snap-align: start; min-height: 44px; padding: 0 var(--s-4); border-radius: 999px; cursor: pointer;
    border: 1px solid var(--line-light); background: var(--bone); color: var(--ink); font-weight: 600; font-size: 0.9375rem;
    display: inline-flex; align-items: center; gap: var(--s-2); transition: background-color 0.2s, color 0.2s;
  }
  .tab:hover { border-color: var(--ink); }
  .tab[aria-selected='true'] { background: var(--ink); color: var(--bone); border-color: var(--ink); }
  .tab__count { font-size: 0.75rem; font-weight: 600; opacity: 0.75; font-variant-numeric: tabular-nums; }
  .panel:focus-visible { outline-offset: 8px; border-radius: var(--radius-l); }

  /* Bento: 1 → 2 → 12-column grid with a featured lead card */
  .bento { display: grid; gap: var(--gutter); grid-template-columns: 1fr; }
  @media (min-width: 680px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bento > :global(.card--featured) { grid-column: 1 / -1; }
  }
  @media (min-width: 1100px) {
    .bento { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-flow: dense; }
    .bento > :global(.card) { grid-column: span 4; }
    .bento > :global(.card--featured) { grid-column: span 8; grid-row: span 2; min-height: 540px; }
    /* If the lead card is alone, let it span the row */
    .bento > :global(.card--featured:only-child) { grid-column: 1 / -1; grid-row: auto; min-height: 360px; }
  }
  .empty { padding: var(--s-7) var(--s-5); border: 1px dashed var(--slate); border-radius: var(--radius-l); text-align: center; color: var(--slate); }
  .empty a { color: var(--ink); font-weight: 600; }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-tablist]');
  if (list) {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = true) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const p = document.getElementById(t.getAttribute('aria-controls')!);
        if (p) p.hidden = !on;
        if (p && on) (window as unknown as { __replay?: (el: Element) => void }).__replay?.(p);
      });
      if (focus) tab.focus();
      tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        let j = -1;
        if (e.key === 'ArrowRight') j = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft') j = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') j = 0;
        if (e.key === 'End') j = tabs.length - 1;
        if (j > -1) { e.preventDefault(); select(tabs[j]); }
      });
    });
    // Deep links from the nav: /#prompts, /#github, /#fonts, /#cat-<key>
    const fromHash = () => {
      const h = location.hash.slice(1).replace(/^cat-/, '');
      const t = tabs.find((x) => x.dataset.tab === h);
      if (t) {
        select(t, false);
        const target = document.getElementById('resources');
        const lenis = (window as unknown as { __lenis?: { scrollTo: (el: Element, o: object) => void } }).__lenis;
        if (target) lenis ? lenis.scrollTo(target, { offset: -70 }) : target.scrollIntoView();
      }
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>
