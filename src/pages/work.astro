---
import Base from '../layouts/Base.astro';
import WorkPreview from '../components/WorkPreview.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import { THUMBNAILS, THUMB_LINK, VIDEOS, BRANDS, EXPERIENCE, EDUCATION, TOOLS, HISTORY_SERIES, PINTEREST } from '../data/work';
---
<Base title="Work" description="Selected work by Syeed Hossain Fahim — AI-assisted ad creatives, social media campaigns, YouTube thumbnails, motion and brand identities.">
  <section class="page-hero grain" aria-labelledby="page-title">
    <div class="container">
      <span class="pill-live" data-reveal>Available for work · Dhaka</span>
      <h1 id="page-title" class="h-display" data-split>Work that <span class="serif">tells a story.</span></h1>
      <p class="lede" data-reveal>Campaigns, thumbnails, motion and identities for e-commerce, education and value-driven brands.</p>
    </div>
  </section>

  <WorkPreview all />

  <section class="section theme-dark" id="history-posters" aria-labelledby="history-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-reveal>Islamic history posters</p>
          <h2 id="history-title" class="h-1" data-split>Heroes of history, <span class="serif">in one frame.</span></h2>
        </div>
        <a class="btn btn-ghost" href={PINTEREST} target="_blank" rel="noopener" data-reveal>See them on Pinterest <Icon name="arrow-up-right" /></a>
      </div>
      {HISTORY_SERIES.map((s) => (
        <div class="series" id={`series-${s.id}`}>
          <div class="series__head" data-reveal>
            <h3 class="series__name">{s.name}</h3>
            <p class="muted">{s.text}</p>
          </div>
          <ul class={`posters posters--${s.posters.length}`} data-stagger="70">
            {s.posters.map((p) => (
              <li data-reveal>
                <a class="poster" href={p.href} target="_blank" rel="noopener">
                  <img src={p.img} alt={`${p.title} — poster of ${p.who}, by Syeed Hossain Fahim`} width={p.w} height={p.h} loading="lazy" decoding="async" />
                  <span class="poster__body"><span class="poster__title">{p.title}</span><span class="poster__who">{p.who}</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="thumbs-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-reveal>YouTube thumbnails</p>
          <h2 id="thumbs-title" class="h-1" data-split>Thumbnails <span class="serif">that drive clicks.</span></h2>
        </div>
        <a class="btn btn-ghost" href={THUMB_LINK} target="_blank" rel="noopener" data-reveal>View on Behance <Icon name="arrow-up-right" /></a>
      </div>
      <ul class="thumbs" data-stagger="80">
        {THUMBNAILS.map((t, i) => <li data-reveal><img src={t} alt={`ITS Academy YouTube thumbnail ${i + 1}`} width="736" height="414" loading="lazy" decoding="async" /></li>)}
      </ul>
    </div>
  </section>

  <section class="section theme-dark" aria-labelledby="motion-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-reveal>Motion & storytelling</p>
          <h2 id="motion-title" class="h-1" data-split>Visuals in motion <span class="serif">and stories.</span></h2>
        </div>
        <p class="muted" data-reveal>Motion graphics, promotional videos and story-led visual history, made for Wafilife and other campaigns.</p>
      </div>
      <ul class="videos" data-stagger="80">
        {VIDEOS.map((id) => (
          <li data-reveal>
            <a class="video" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">
              <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
              <span class="video__play" aria-hidden="true">▶</span>
              <span class="sr-only">Watch on YouTube (opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="brands-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-reveal>Brand identity</p>
          <h2 id="brands-title" class="h-1" data-split>Crafting identities <span class="serif">from scratch.</span></h2>
        </div>
      </div>
      <ul class="brands" data-stagger="70">
        {BRANDS.map((b) => (
          <li data-reveal>
            <a class="brand" href={b.href} target="_blank" rel="noopener" data-tilt>
              <img src={b.img} alt={`${b.name} logo`} width="1200" height="1600" loading="lazy" decoding="async" />
              <span class="brand__body"><span class="brand__tag">{b.tag}</span><span class="brand__name">{b.name}</span><span class="brand__text">{b.text}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Services />

  <section class="section" id="experience" aria-labelledby="xp-title">
    <div class="container xp-grid">
      <div>
        <p class="eyebrow" data-reveal>Experience</p>
        <h2 id="xp-title" class="h-1" data-split>A trajectory <span class="serif">through creative space.</span></h2>
        <ol class="timeline">
          {EXPERIENCE.map((x) => (
            <li data-reveal>
              <span class="tl__when">{x.when}{x.now && <span class="tl__now">Now</span>}</span>
              <h3 class="tl__role">{x.role}</h3>
              <p class="tl__org">{x.org}</p>
              <ul>{x.points.map((p) => <li>{p}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <p class="eyebrow" data-reveal>Education</p>
        <h2 class="h-2" data-split>Foundations in science, <span class="serif">fluent in design.</span></h2>
        <ol class="edu">
          {EDUCATION.map((e) => <li data-reveal><span class="tl__when">{e.when}</span><strong>{e.title}</strong><span class="muted">{e.org}</span></li>)}
        </ol>
        <p class="eyebrow tools-h" data-reveal>Tools & AI workflow</p>
        <ul class="chips" data-reveal>{TOOLS.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <Contact />
</Base>

<style>
  .series + .series { margin-top: var(--s-8); }
  .series__head { display: grid; gap: var(--s-2); margin-bottom: var(--s-5); max-width: 60ch; }
  .series__name { font-family: var(--font-display); font-size: var(--step-2); }
  .posters { list-style: none; padding: 0; display: grid; gap: var(--gutter); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .posters--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } .posters--6 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .posters--6 { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .poster { position: relative; display: block; border-radius: var(--radius-m); overflow: hidden; border: 1px solid var(--border); text-decoration: none; isolation: isolate; }
  .poster img { width: 100%; height: auto; display: block; transition: transform 0.6s var(--ease-out); }
  .poster:hover img { transform: scale(1.03); }
  .poster__body { padding: var(--s-3); display: grid; gap: 2px; background: var(--bg-deep); border-top: 1px solid var(--border); }
  .poster__title { font-family: var(--font-display); font-weight: 700; }
  .poster__who { font-size: 0.78rem; color: var(--text-soft); }
  .page-hero { position: relative; padding-top: calc(110px + clamp(2rem, 1rem + 4vw, 5rem)); padding-bottom: var(--s-5); background: radial-gradient(50% 70% at 85% 0%, rgb(10 61 143 / 0.8), transparent 70%), var(--bg); overflow: hidden; }
  .page-hero .h-display { margin-top: var(--s-5); }
  .page-hero .lede { margin-top: var(--s-5); max-width: 52ch; }
  .thumbs, .videos { list-style: none; padding: 0; display: grid; gap: var(--gutter); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .thumbs, .videos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .thumbs img { width: 100%; border-radius: var(--radius-m); border: 1px solid var(--border); aspect-ratio: 16 / 9; object-fit: cover; }
  .video { position: relative; display: block; border-radius: var(--radius-m); overflow: hidden; border: 1px solid var(--border); aspect-ratio: 16 / 9; }
  .video img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out); }
  .video:hover img { transform: scale(1.04); }
  .video__play { position: absolute; inset: 0; margin: auto; width: 68px; height: 68px; border-radius: 50%; display: grid; place-items: center; background: var(--text); color: var(--bg); font-size: 1.2rem; padding-left: 4px; box-shadow: 0 0 0 10px rgb(247 248 255 / 0.15); }
  .brands { list-style: none; padding: 0; display: grid; gap: var(--gutter); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .brands { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .brand { position: relative; display: block; border-radius: var(--radius-l); overflow: hidden; border: 1px solid var(--border); aspect-ratio: 3 / 4; text-decoration: none; isolation: isolate; }
  .brand img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .brand::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 50%, rgb(3 7 18 / 0.92)); }
  .brand__body { position: absolute; inset: auto 0 0; padding: var(--s-4); display: grid; gap: 2px; }
  .brand__tag { font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-soft); }
  .brand__name { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); }
  .brand__text { font-size: 0.82rem; color: var(--text-soft); display: none; }
  @media (min-width: 900px) { .brand__text { display: block; } }
  .xp-grid { display: grid; gap: var(--s-8); }
  @media (min-width: 1000px) { .xp-grid { grid-template-columns: 3fr 2fr; } }
  .timeline, .edu { list-style: none; padding: 0; margin-top: var(--s-6); display: grid; gap: var(--gutter); }
  .timeline > li, .edu > li { padding: var(--s-5); border-radius: var(--radius-l); border: 1px solid var(--border); background: var(--glass); display: grid; gap: 4px; }
  .timeline ul { margin-top: var(--s-2); padding-left: 1.1em; color: var(--text-soft); display: grid; gap: 4px; }
  .tl__when { font-size: 0.8rem; color: var(--muted); display: flex; gap: 8px; align-items: center; }
  .tl__now { padding: 2px 8px; border-radius: 999px; background: rgb(74 222 128 / 0.12); color: var(--success); font-size: 0.7rem; font-weight: 600; }
  .tl__role { font-family: var(--font-display); font-size: var(--step-1); }
  .tl__org { color: var(--accent); }
  .tools-h { margin-top: var(--s-7); }
  .chips { list-style: none; padding: 0; margin-top: var(--s-4); display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .chips li { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border-strong); font-size: 0.85rem; color: var(--text-soft); }
</style>
