---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn’t exist. Browse every free resource on the home page.">
  <section class="section theme-dark" style="padding-top:calc(68px + 6rem);min-height:70vh">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="h-1" style="margin-top:1rem">This link has <span class="serif" style="color:var(--sand)">wandered off.</span></h1>
      <p class="lede" style="margin-top:1.5rem">The post may have moved. Every resource is still on the home page.</p>
      <p style="margin-top:2rem"><a class="btn btn-primary" href="/#resources">Browse resources</a></p>
    </div>
  </section>
</Base>
